// # Streaming MCP Server for Kernel Dmesg
//
// Logline: JSON-RPC 2.0 stdio server providing capability-bounded kernel ring buffer inspection tools.
//
// Setup: Bridges standard input/output streaming protocol to kernel event filters and boot showcases.
//
// Beats:
//   1. Handle MCP initialize handshake with server metadata and capability declarations.
//   2. Expose tools/list catalogue with five sovereign dmesg diagnostic tools.
//   3. Dispatch tools/call for read, search, filter_level, stats, and demo.
//   4. Deliver streaming JSON-RPC responses over standard output.

import "kernel/kmsg_types.oo";
import "kernel/kmsg_filter.oo";
import "render/render_ansi.oo";
import "render/render_json.oo";
import "render/synthetic_boot.oo";
import "ipc/json_field.oo";

fn build_error(id: String, code: Int, msg: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":"
        + code.to_string() + ",\"message\":\"" + json_escape(msg) + "\"}}\n";
}

fn build_tool_result(id: String, text: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\""
        + json_escape(text) + "\"}]}}\n";
}

pub fn render_mcp_init(id: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id
        + ",\"result\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"oodmesg\",\"version\":\"0.2.0\"}}}\n";
}

pub fn render_mcp_tools_list(id: String) -> String {
    let mut out: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"tools\":[";
    out = out + "{\"name\":\"dmesg_read\",\"description\":\"Read kernel ring buffer log messages with optional severity filter and limit.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"level\":{\"type\":\"string\"},\"limit\":{\"type\":\"integer\"},\"json_mode\":{\"type\":\"boolean\"}}}}";
    out = out + ",{\"name\":\"dmesg_search\",\"description\":\"Search kernel ring buffer messages matching a substring query.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"}},\"required\":[\"query\"]}}";
    out = out + ",{\"name\":\"dmesg_filter_level\",\"description\":\"Filter kernel messages by severity level string (emerg, alert, crit, err, warn, notice, info, debug).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"level\":{\"type\":\"string\"}},\"required\":[\"level\"]}}";
    out = out + ",{\"name\":\"dmesg_stats\",\"description\":\"Summarize total counts of kernel messages grouped by severity level.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}";
    out = out + ",{\"name\":\"dmesg_demo\",\"description\":\"Run synthetic demonstration of Linux kernel boot sequence.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"json_mode\":{\"type\":\"boolean\"}}}}";
    out = out + "]}}\n";
    return out;
}

pub fn handle_mcp_call(
    id: String,
    tool_name: String,
    req: String
) -> String {
    let msgs: List[KernelMessage] = build_synthetic_boot_log();

    if tool_name == "dmesg_demo" {
        let json_mode: Bool = json_extract_bool_field(req, "json_mode", false);
        return build_tool_result(id, run_synthetic_boot_demo(json_mode, false));
    }

    if tool_name == "dmesg_read" {
        let mut opts: KmsgOpts = default_kmsg_opts();
        opts.level_filter = json_extract_str_field(req, "level");
        opts.limit = json_extract_int_field(req, "limit", 0);
        let json_mode: Bool = json_extract_bool_field(req, "json_mode", false);

        let filtered: List[KernelMessage] = filter_messages(msgs, opts);
        let out: String = if json_mode {
            format_json_messages(filtered)
        } else {
            format_message_list_ansi(filtered, false)
        };
        return build_tool_result(id, out);
    }

    if tool_name == "dmesg_search" {
        let q: String = json_extract_str_field(req, "query");
        let mut matching: List[KernelMessage] = list_new();
        let n: Int = list_len(msgs);
        let mut i: Int = 0;
        while i < n {
            let m: KernelMessage = list_get(msgs, i);
            if matches_query(m, q) {
                matching = list_push(matching, m);
            }
            i = i + 1;
        }
        return build_tool_result(id, format_message_list_ansi(matching, false));
    }

    if tool_name == "dmesg_filter_level" {
        let lvl: String = json_extract_str_field(req, "level");
        let mut opts: KmsgOpts = default_kmsg_opts();
        opts.level_filter = lvl;
        let filtered: List[KernelMessage] = filter_messages(msgs, opts);
        return build_tool_result(id, format_message_list_ansi(filtered, false));
    }

    if tool_name == "dmesg_stats" {
        let mut stats: String = "Kernel Ring Buffer Severity Distribution:\n";
        let mut l: Int = 0;
        while l <= 7 {
            let cnt: Int = count_level_occurrences(msgs, l);
            stats = stats + "  " + level_to_name(l) + " (" + l.to_string() + "): " + cnt.to_string() + " events\n";
            l = l + 1;
        }
        return build_tool_result(id, stats);
    }

    return build_error(id, -32601, "Method or tool not found: " + tool_name);
}

pub fn handle_mcp_message(req: String) -> String {
    let id_str: String = json_extract_str_field(req, "id");
    let id_int: Int = json_extract_int_field(req, "id", -1);
    let id: String = if chars_len(id_str) > 0 {
        "\"" + id_str + "\""
    } else if id_int >= 0 {
        id_int.to_string()
    } else {
        "1"
    };
    let method: String = json_extract_str_field(req, "method");

    if method == "initialize" {
        return render_mcp_init(id);
    }
    if method == "notifications/initialized" {
        return "";
    }
    if method == "tools/list" {
        return render_mcp_tools_list(id);
    }
    if method == "tools/call" {
        let tool_name: String = json_extract_str_field(req, "name");
        return handle_mcp_call(id, tool_name, req);
    }
    if method == "shutdown" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}\n";
    }
    return build_error(id, -32601, "Method not found: " + method);
}

fn find_newline_pos(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        if byte_at(s, i) == 10 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn run_mcp_server(fr: &FsReadCap) {
    let mut buf: String = "";
    let mut running: Bool = true;
    while running {
        let r: Result[String, String] = oo_read_stdin_chunk(fr, 4096);
        if !r.is_ok() {
            running = false;
        } else {
            let chunk: String = match r { Ok(s) => s, Err(_) => "" };
            if chars_len(chunk) == 0 {
                running = false;
            } else {
                buf = buf + chunk;
                let mut nl_pos: Int = find_newline_pos(buf);
                while nl_pos >= 0 {
                    let line: String = str_slice(buf, 0, nl_pos);
                    buf = str_slice(buf, nl_pos + 1, chars_len(buf));
                    let trimmed: String = str_trim(line);
                    if chars_len(trimmed) > 0 {
                        let resp: String = handle_mcp_message(trimmed);
                        if chars_len(resp) > 0 {
                            print(resp);
                        }
                    }
                    nl_pos = find_newline_pos(buf);
                }
            }
        }
    }
}
